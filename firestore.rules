rules_version = '2';

// Infinity Home — allow signed-in Firebase users to read/write app data.
// Publish in Firebase Console → Firestore → Rules, or: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
