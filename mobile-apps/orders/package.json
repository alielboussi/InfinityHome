{
  "name": "orders-app",
  "version": "0.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "materialize": "node scripts/materializeSharedStandalone.js && node scripts/materializeOrdersUi.js",
    "icons": "node scripts/ensureOrdersIcons.js",
    "postinstall": "node scripts/materializeSharedStandalone.js && node scripts/materializeOrdersUi.js && node scripts/ensureOrdersIcons.js",
    "prestart": "node scripts/materializeSharedStandalone.js && node scripts/materializeOrdersUi.js && node scripts/ensureOrdersIcons.js",
    "start": "expo start --go",
    "start:offline": "expo start --offline --go",
    "android": "expo start --android",
    "eas:build:android": "node scripts/materializeSharedStandalone.js && node scripts/materializeOrdersUi.js && eas build --platform android --profile preview --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^13.3.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "expo": "~58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "firebase": "^11.10.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "babel-preset-expo": "~58.0.0"
  },
  "private": true
}
