{
  "name": "warehouse-delivery",
  "version": "0.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "verify": "node scripts/verifyDeliveryApp.js",
    "postinstall": "node scripts/materializeDeliveryStandalone.js && node scripts/applyDeliveryKitPatches.js && node scripts/assertDeliveryKitStandalone.js && node scripts/assertDeliverySharedStandalone.js && node scripts/ensureDeliveryIcons.js",
    "prestart": "node scripts/assertDeliveryKitStandalone.js && node scripts/assertDeliverySharedStandalone.js && node scripts/verifyDeliveryApp.js",
    "materialize": "node scripts/materializeDeliveryStandalone.js",
    "icons": "node scripts/ensureDeliveryIcons.js",
    "eas:build:android": "node scripts/materializeDeliveryStandalone.js && node scripts/verifyDeliveryApp.js && eas build --platform android --profile preview --non-interactive",
    "start": "expo start --go",
    "start:offline": "expo start --offline --go",
    "android": "expo start --android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^13.3.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "expo": "~58.0.21",
    "expo-build-properties": "~0.14.8",
    "expo-auth-session": "~58.0.16",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-application": "~58.1.2",
    "expo-device": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-print": "~58.0.8",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "firebase": "^11.10.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-zeroconf": "^0.17.6"
  },
  "devDependencies": {
    "@react-native/babel-plugin-codegen": "0.88.1",
    "babel-preset-expo": "~58.0.0",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "@react-native/babel-plugin-codegen": "0.88.1"
  },
  "private": true
}
