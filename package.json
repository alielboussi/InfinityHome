    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "dotenv": "^16.4.5",
    "font-awesome": "^4.7.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "http-proxy-middleware": "^2.0.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "jszip": "^3.10.1",
    "nodemailer": "^7.0.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "proxy": "",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "prebuild": "node scripts/checkEnv.js",
    "postinstall": "node scripts/silenceHtml5QrcodeSourceMaps.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "scan:unused": "node scripts/scan-unused-files.js",
    "scan:unused:rename": "node scripts/scan-unused-files.js --rename",
