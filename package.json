    "layby:smoke": "node scripts/laybySmokeTest.js",
    "layby:bench": "node scripts/laybyBench.js",
    "layby:bench:batch": "node scripts/laybyBenchBatch.js",
    "db:types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_REF --schema public > supabase/types/database.types.d.ts",
    "gen:types": "npm run db:types"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5"
  }
