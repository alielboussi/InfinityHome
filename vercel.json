{
  "functions": {
    "api/stocktake.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "infinity-home-pi.vercel.app" }
      ],
      "destination": "https://www.infinity-home.online/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "infinityhome.app" }
      ],
      "destination": "https://www.infinity-home.online/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "www.infinityhome.app" }
      ],
      "destination": "https://www.infinity-home.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/stocktake-login", "destination": "/api/stocktake?action=login" },
    { "source": "/api/auth-profile", "destination": "/api/stocktake?action=auth-profile" },
    { "source": "/api/stocktake-locations", "destination": "/api/stocktake?action=locations" },
    { "source": "/api/stocktake-location-state", "destination": "/api/stocktake?action=location-state" },
    { "source": "/api/stocktake-catalog", "destination": "/api/stocktake?action=catalog" },
    { "source": "/api/stocktake-events-list", "destination": "/api/stocktake?action=events-list" },
    { "source": "/api/stocktake-open-sessions", "destination": "/api/stocktake?action=open-sessions" },
    { "source": "/api/stocktake-event-get", "destination": "/api/stocktake?action=event-get" },
    { "source": "/api/stocktake-event-create", "destination": "/api/stocktake?action=event-create" },
    { "source": "/api/stocktake-event-set-gate", "destination": "/api/stocktake?action=event-set-gate" },
    { "source": "/api/stocktake-count-add", "destination": "/api/stocktake?action=count-add" },
    { "source": "/api/stocktake-count-mine", "destination": "/api/stocktake?action=count-mine" },
    { "source": "/api/stocktake-count-remove-mine", "destination": "/api/stocktake?action=count-remove-mine" },
    { "source": "/api/stocktake-count-clear-mine", "destination": "/api/stocktake?action=count-clear-mine" },
    { "source": "/api/stocktake-counts-import", "destination": "/api/stocktake?action=counts-import" },
    { "source": "/api/stocktake-counts-clear", "destination": "/api/stocktake?action=counts-clear" },
    { "source": "/api/stocktake-import-template", "destination": "/api/stocktake?action=import-template" },
    { "source": "/api/stocktake-set-scan", "destination": "/api/stocktake?action=set-scan" },
    { "source": "/api/stocktake-product-create", "destination": "/api/stocktake?action=product-create" },
    { "source": "/api/stocktake-set-create", "destination": "/api/stocktake?action=set-create" },
    { "source": "/api/stocktake-event-submit", "destination": "/api/stocktake?action=event-submit" },
    { "source": "/api/stocktake-event-cancel", "destination": "/api/stocktake?action=event-cancel" },
    { "source": "/api/stocktake-periods-list", "destination": "/api/stocktake?action=periods-list" },
    { "source": "/api/stocktake-period-detail", "destination": "/api/stocktake?action=period-detail" },
    { "source": "/api/stocktake-period-variance", "destination": "/api/stocktake?action=period-variance" },

    { "source": "/api/payments", "destination": "/api/transactions?action=payments" },
    { "source": "/api/payments-list", "destination": "/api/transactions?action=payments-list" },
    { "source": "/api/payments-delete", "destination": "/api/transactions?action=payments-delete" },
    { "source": "/api/layby-statement", "destination": "/api/transactions?action=layby-statement" },
    { "source": "/api/layby-payments-delete", "destination": "/api/transactions?action=layby-payments-delete" },
    { "source": "/api/layby-delete-customer", "destination": "/api/transactions?action=layby-delete-customer" },
    { "source": "/api/quote-convert-layby", "destination": "/api/transactions?action=quote-convert-layby" },

    { "source": "/api/customer-statement", "destination": "/api/customers?action=statement" },
    { "source": "/api/customer-totals", "destination": "/api/customers?action=totals" },

    { "source": "/l/:customerId", "destination": "/api/customers?action=layby-pdf&customerId=:customerId" },

    { "source": "/api/pos-catalog", "destination": "/api/admin?adminAction=pos-catalog" },
    { "source": "/api/quotation-read", "destination": "/api/admin?adminAction=quotation-read" },

    { "source": "/api/label-print-job", "destination": "/api/labels?action=job" },
    { "source": "/api/label-print-history", "destination": "/api/labels?action=history" },

    { "source": "/api/whatsapp-sale", "destination": "/api/notify?action=whatsapp-sale" },
    { "source": "/api/whatsapp-layby", "destination": "/api/notify?action=whatsapp-layby" },
    { "source": "/api/whatsapp-transfer", "destination": "/api/notify?action=whatsapp-transfer" },
    { "source": "/api/whatsapp-labels", "destination": "/api/notify?action=whatsapp-labels" },
    { "source": "/api/whatsapp-lusaka-transfer", "destination": "/api/notify?action=whatsapp-lusaka-transfer" },
    { "source": "/api/whatsapp-shop-order", "destination": "/api/notify?action=whatsapp-shop-order" },
    { "source": "/api/whatsapp-ledger", "destination": "/api/notify?action=whatsapp-ledger" },
    { "source": "/api/monthly-balance-dues", "destination": "/api/notify?action=monthly-balance-dues" },
    { "source": "/api/monthly-balance-send", "destination": "/api/notify?action=monthly-balance-send" },
    { "source": "/api/layby-overdue-reminders", "destination": "/api/notify?action=layby-overdue-reminders" },
    { "source": "/api/telegram-sale", "destination": "/api/notify?action=whatsapp-sale" },
    { "source": "/api/telegram-layby", "destination": "/api/notify?action=whatsapp-layby" },
    { "source": "/api/telegram-transfer", "destination": "/api/notify?action=whatsapp-transfer" },

    { "source": "/api/diag-env", "destination": "/api/health?action=env" },
    { "source": "/api/diag-tables", "destination": "/api/health?action=tables" },
    { "source": "/api/diag-checkout", "destination": "/api/health?action=checkout" },
    { "source": "/api/diag", "destination": "/api/health" },

    { "source": "/api/factory-production-approve", "destination": "/api/admin?adminAction=factory-production-approve" },
    { "source": "/api/inventory-bulk", "destination": "/api/admin?adminAction=inventory-bulk" },
    { "source": "/api/product-locations", "destination": "/api/admin?adminAction=product-locations" },
    { "source": "/api/products-bulk-delete", "destination": "/api/admin?adminAction=products-bulk-delete" },
    { "source": "/api/quotation-save", "destination": "/api/admin?adminAction=quotation-save" },
    { "source": "/api/sales-edit", "destination": "/api/admin?adminAction=sales-edit" },
    { "source": "/api/sales-adjustment", "destination": "/api/admin?adminAction=sales-adjustment" },
    { "source": "/api/user-activity", "destination": "/api/admin?adminAction=user-activity" },
    { "source": "/api/login-access", "destination": "/api/admin?adminAction=login-access" },
    { "source": "/api/db-backup", "destination": "/api/admin?adminAction=db-backup" },
    { "source": "/api/full-firebase-backup", "destination": "/api/admin?adminAction=full-firebase-backup" },

    { "source": "/api/product-image-search", "destination": "/api/admin?adminAction=product-image-search" },

    { "source": "/api/shop-catalog", "destination": "/api/admin?adminAction=shop-catalog" },
    { "source": "/api/web-orders", "destination": "/api/admin?adminAction=web-orders" },

    { "source": "/api/opening-stock-entry", "destination": "/api/admin?adminAction=inventory-bulk&action=opening-stock-entry" },
    { "source": "/api/inventory-snapshot", "destination": "/api/admin?adminAction=inventory-bulk&action=snapshot" },
    { "source": "/api/combo-locations", "destination": "/api/admin?adminAction=product-locations&action=combo" },

    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/notify?action=monthly-balance-dues",
      "schedule": "0 6 30 * *"
    },
    {
      "path": "/api/full-firebase-backup",
      "schedule": "0 4 */5 * *"
    },
    {
      "path": "/api/notify?action=layby-overdue-reminders",
      "schedule": "0 7 * * *"
    }
  ]
}
